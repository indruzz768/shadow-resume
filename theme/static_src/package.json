{
  "name": "theme",
  "version": "3.5.0",
  "scripts": {
    "start": "npm run dev",
    "build": "npm run build:tailwind",                        
    "build:win": "npm run build:tailwind-win",                 
    "build:tailwind": "NODE_ENV=production tailwindcss --postcss -i ./src/input.css -o ../static/css/dist/styles.css --minify",
    "build:tailwind-win": "cross-env NODE_ENV=production tailwindcss --postcss -i ./src/input.css -o ../static/css/dist/styles.css --minify",
    "dev": "cross-env NODE_ENV=development tailwindcss --postcss -i ./src/input.css -o ../static/css/dist/styles.css -w"
  },
  
  "dependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/line-clamp": "^0.4.2",
    "@tailwindcss/typography": "^0.5.2",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.14",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^3.2.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
